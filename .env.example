# CommerceLab — AI doubt-tutor (OPTIONAL). Leave everything unset to keep the
# tutor dormant: the UI still renders and degrades gracefully ("not switched on yet").
#
# These are set in the Vercel dashboard (Project → Settings → Environment Variables)
# at deploy time — NOT committed and NOT stored on a local machine. The proxy is
# provider-agnostic: any OpenAI-compatible /chat/completions endpoint works.

# Required to switch the tutor ON. Free tier, no credit card: https://console.groq.com/keys
LLM_API_KEY=

# OpenAI-compatible base URL (default targets the Groq free tier).
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1      (use a ":free" model)
#   Cerebras:    https://api.cerebras.ai/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model id for TEXT questions — must exist on the chosen provider.
#   Groq open models: llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it
LLM_MODEL=llama-3.3-70b-versatile

# Model id used AUTOMATICALLY when a student attaches an image (must be vision-capable).
# Groq's free vision model. The same Groq key above covers it — no extra signup.
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct


# ── Login / Auth (OPTIONAL — Supabase). Leave both unset to keep auth DORMANT:
#    the whole site stays open and the login page shows "not switched on yet".
#    Set both (Vercel → Settings → Environment Variables) to require login for the
#    interactive tools (calculators, practice, AI tutor). Browse pages stay public.
#    These are PUBLIC client values (the anon key is safe to ship). See docs/AUTH.md.
#    Create a free project at https://supabase.com → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
